# AHE .gitignore

# Don't track empty evidence reports
evidence/reports/*
!evidence/reports/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
lib-cov
coverage
*.lcov
.nyc_output

# Dependencies
node_modules/
jspm_packages/
web_modules/
bower_components
.pnpm-store

# Build output
.next
out
.nuxt
dist
.output
.cache/
.parcel-cache
.vuepress/dist
.temp
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/

# TypeScript
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Editor
.tern-port
.vscode-test

# OS
.DS_Store
Thumbs.db

# npm/yarn/pnpm
.npm
.eslintcache
.stylelintcache
.node_repl_history
.yarn-integrity
*.tgz
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Grunt
.grunt

# node-waf
.lock-wscript

# build/Release
build/Release

# Gatsby
.cache/

# Firebase
.firebase/

# TernJS
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test
